# Entorno de Ejecución
NODE_ENV=development
PORT=3000

# Base de Datos (Configuración por defecto: SQLite local, escalable a PostgreSQL)
DB_CLIENT=sqlite3
DB_FILENAME=./src/database/level_trap.sqlite

